{
  "entities": {
    "User": {
      "title": "User",
      "description": "Patient or Doctor profile data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "age": { "type": "integer" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "isSharingEnabled": { "type": "boolean" }
      },
      "required": ["name", "email", "role"]
    },
    "Record": {
      "title": "Medical Record",
      "description": "A medical record uploaded by a patient",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "fileURL": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "fileName": { "type": "string" }
      },
      "required": ["patientId", "fileURL", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/records/{recordId}": {
      "schema": "Record",
      "description": "Medical records collection"
    }
  }
}
